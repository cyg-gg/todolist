# ==============================
# 根目录 .dockerignore
# ==============================

# Git
.git
.gitignore
.gitattributes

# 日志 & 临时文件
*.log
*.tmp
*.pid
npm-debug.log*

# 本地开发 node_modules（镜像内会重新安装）
node_modules
**/node_modules

# 前端编译输出（镜像内会重新 build）
frontend/dist
frontend/.env.local
frontend/.env.development

# 后端环境变量（线上由 docker-compose.prod.yml 注入，不打包进镜像）
backend/.env
backend/.env.local

# 文档 & 脚本（不进镜像）
docs
*.md
*.sh
deploy-scripts.tar.gz
scripts

# CI/CD
.github

# IDE
.vscode
.idea
*.swp
*.swo
